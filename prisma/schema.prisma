// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Student {
  id            Int       @id @default(autoincrement())
  rollNo        String    @unique
  hostelNumber  String    
  hostelName    String     
  name          String    
  email         String    @unique
  department    String     
  semester      Int
  hostelRollNo  String    @unique
  roomNumber    String    
  orders        OrderBill[]
  payments      Payment[]
  role          String    @default("student")
  password      String   
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at") 
}

model Incharge {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  hostelNumber  String     
  hostelName    String
  registrationId String   @unique
  role          String    @default("admin")
  password      String  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")  
}

model OrderBill {
  id            Int      @id @default(autoincrement())
  itemName      String
  itemPrice     Float
  buyerId       Int      
  buyer         Student  @relation(fields: [buyerId], references: [id])
   createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
}

model Payment {
  id          Int       @id @default(autoincrement())
  amount      Float
  status      String    @default("pending") // pending, paid, partial
  dueDate     DateTime
  paidDate    DateTime?
  studentId   Int
  student     Student   @relation(fields: [studentId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
}
